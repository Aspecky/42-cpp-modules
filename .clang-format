UseTab: Always
TabWidth: 4
IndentWidth: 4

# AlignConsecutiveDeclarations: true
AllowShortFunctionsOnASingleLine: None

BreakBeforeBraces: Custom
BraceWrapping:
    AfterFunction: true
    AfterClass: false
    AfterControlStatement: false
    AfterEnum: false
    AfterNamespace: false
    AfterStruct: false
    AfterUnion: false
    BeforeElse: true
